module base()
{
    a = 27;
    translate([-a+1,-a/2,0]) cube([a,a,2]);
    translate([-1,-a/2,0]) cube([a,a,2]);
    translate([-a/2,0-2,0]) cube([a,a,2]);
    translate([-a/2,-a+2,0]) cube([a,a,2]);
}

module key_ring()
{
    color("white") translate([0,0,2]) scale([2,2,1]) logo();
    
    A = 30;
    a = 26;
    color([0.2,0.2,0.2])
    {
        //translate([-A/2,-A/2,0]) cube([A,A,2]);
        difference()
        {
            union()
            {
                base();
                translate([0,a,0]) cylinder(d=8,h=2);
            }
            translate([0,a,-0.1]) cylinder(d=4,h=2.2);
        }
        
    }
}

scale([0.75,0.75,1])key_ring();